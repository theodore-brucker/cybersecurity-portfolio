---
layout: base.njk
---
{#- Topic hub: an intro written in the template body, then every published post
    carrying one of the hub's `topicTags`, newest first. -#}
{%- set topicPosts = collections.posts | postsWithTags(topicTags) %}
<section class="topic">
  {% include "breadcrumb.njk" %}
  {%- if draft %}
  <p class="draft-note">Draft: this page is built for local and preview builds only. Set <code>draft: false</code> once the intro is written and at least one post carries this topic's tags.</p>
  {%- endif %}
  <h1>{{ title }}</h1>

  <div class="topic-intro">
    {{ content | safe }}
  </div>

  <h2 class="eyebrow">Posts</h2>
  {%- if topicPosts.length %}
  <ul class="post-list">
    {%- for post in topicPosts %}
    <li>
      <span class="post-date"><time datetime="{{ post.date | dateOnly }}">{{ post.date | readableDate }}</time></span>
      <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      <p>{{ post.data.summary }}</p>
    </li>
    {%- endfor %}
  </ul>
  {%- else %}
  <p>No published posts carry this topic's tags yet.</p>
  {%- endif %}
</section>
