<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- set documentTitle = pageTitle or (title + " | " + site.title) %}
  {%- set metaDescription = description or summary %}
  {%- set canonicalUrl = site.url + page.url %}
  {%- set socialImage = ogImage or site.ogImage %}

  <title>{{ documentTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <meta name="author" content="{{ site.author.name }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ canonicalUrl }}">
  {%- endif %}
  <link rel="me" href="{{ site.author.linkedin }}">
  <link rel="me" href="{{ site.author.github }}">
  {%- if page.url == "/" and site.verification.google %}
  <meta name="google-site-verification" content="{{ site.verification.google }}">
  {%- endif %}
  {%- if page.url == "/" and site.verification.bing %}
  <meta name="msvalidate.01" content="{{ site.verification.bing }}">
  {%- endif %}
  <link rel="preload" href="/fonts/public-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/public-sans-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/styles.css">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }} blog" href="{{ site.url }}/feed.xml">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ ogTitle or title or documentTitle }}">
  {#- Posts keep their summary as the social preview text; search snippets use the description. #}
  <meta property="og:description" content="{{ summary or metaDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ site.url }}{{ socialImage.src }}">
  <meta property="og:image:width" content="{{ socialImage.width }}">
  <meta property="og:image:height" content="{{ socialImage.height }}">
  <meta property="og:image:alt" content="{{ socialImage.alt }}">
  {%- if ogType == "article" %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:modified_time" content="{{ page.date | modifiedDate(updated) | isoDate }}">
  <meta property="article:author" content="{{ site.url }}/">
  {%- for tag in tags | reject("equalto", "posts") %}
  <meta property="article:tag" content="{{ tag }}">
  {%- endfor %}
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image:alt" content="{{ socialImage.alt }}">
  {%- if not noindex %}
  {%- set structured = {
    page: page,
    documentTitle: documentTitle,
    title: title,
    description: description,
    summary: summary,
    tags: tags,
    updated: updated,
    breadcrumb: breadcrumb,
    schemaType: schemaType,
    wordCount: wordCount,
    image: image,
    imageAlt: imageAlt
  } %}
  <script type="application/ld+json">
{{ structured | structuredData(site, collections) | safe }}
  </script>
  {%- endif %}
</head>
<body>
  <div class="marking-bar">Unclassified&nbsp;//&nbsp;Personal site&nbsp;//&nbsp;All views my own</div>

  <header class="site-head">
    <div class="shell">
      <a class="wordmark" href="/">Theo Brucker<span class="creds">CISSP</span></a>
      <nav class="site-nav" aria-label="Site">
        <ul>
          <li><a href="/#about">About</a></li>
          <li><a href="/#experience">Experience</a></li>
          <li><a href="/#projects">Projects</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="shell">
    {{ content | safe }}
  </main>

  <footer class="site-foot">
    <div class="shell">
      <p class="disclaimer">{{ site.disclaimer }}</p>
      <p class="pledge">{{ site.pledge }}</p>
      <p class="colophon">&copy; {{ site.buildYear }} {{ site.author.name }} &middot; <a href="/feed.xml">RSS</a> &middot; <a href="{{ site.author.github }}">GitHub</a> &middot; <a href="{{ site.author.linkedin }}">LinkedIn</a></p>
    </div>
  </footer>
</body>
</html>
