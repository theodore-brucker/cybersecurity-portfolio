<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- set documentTitle = pageTitle or (title + " | " + site.title) %}
  {%- set metaDescription = description or summary %}
  {%- set canonicalUrl = site.url + page.url %}
  {%- set socialImage = ogImage or site.ogImage %}

  <title>{{ documentTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <meta name="author" content="{{ site.author.name }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <link rel="canonical" href="{{ canonicalUrl }}">
  {%- endif %}
  <link rel="me" href="{{ site.author.linkedin }}">
  <link rel="me" href="{{ site.author.github }}">
  {%- if page.url == "/" and site.verification.google %}
  <meta name="google-site-verification" content="{{ site.verification.google }}">
  {%- endif %}
  {%- if page.url == "/" and site.verification.bing %}
  <meta name="msvalidate.01" content="{{ site.verification.bing }}">
  {%- endif %}
  <link rel="preload" href="/fonts/charis-sil-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/charis-sil-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/styles.css">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }} blog" href="{{ site.url }}/feed.xml">
  {%- if ogType == "article" %}
  <link rel="alternate" type="text/markdown" title="{{ title }} (Markdown)" href="{{ canonicalUrl }}index.md">
  {%- endif %}
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#1F3B32">

  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ ogTitle or title or documentTitle }}">
  {#- Posts keep their summary as the social preview text; search snippets use the description. #}
  <meta property="og:description" content="{{ summary or metaDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ site.url }}{{ socialImage.src }}">
  <meta property="og:image:width" content="{{ socialImage.width }}">
  <meta property="og:image:height" content="{{ socialImage.height }}">
  <meta property="og:image:alt" content="{{ socialImage.alt }}">
  {%- if ogType == "article" %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  <meta property="article:modified_time" content="{{ page.date | modifiedDate(updated) | isoDate }}">
  <meta property="article:author" content="{{ site.url }}/">
  {%- for tag in tags | reject("equalto", "posts") %}
  <meta property="article:tag" content="{{ tag }}">
  {%- endfor %}
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image:alt" content="{{ socialImage.alt }}">
  {%- if not noindex %}
  {%- set structured = {
    page: page,
    documentTitle: documentTitle,
    title: title,
    description: description,
    summary: summary,
    tags: tags,
    updated: updated,
    breadcrumb: breadcrumb,
    schemaType: schemaType,
    wordCount: wordCount,
    image: image,
    imageAlt: imageAlt,
    faq: faq,
    sources: sources,
    topicTags: topicTags,
    topicName: topicName
  } %}
  <script type="application/ld+json">
{{ structured | structuredData(site, collections) | safe }}
  </script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  {#- The homepage gets the green band with the headshot, and its <h1> is the
      name. Every other page gets a slim header and its own <h1>. #}
  {%- if page.url == "/" %}
  {% include "home-band.njk" %}
  {%- else %}
  <header class="site-head">
    <div class="shell">
      <p class="site-title"><a class="wordmark" href="/">{{ site.author.name }}</a></p>
      <nav class="site-nav" aria-label="Site">
        <ul>
          <li><a href="/blog/"{% if page.url == "/blog/" %} aria-current="page"{% endif %}>Writing</a></li>
          <li><a href="/#work">Work</a></li>
          <li><a href="/#certifications">Certifications</a></li>
          <li><a href="/#projects">Projects</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>
  {%- endif %}

  <main id="main"{% if page.url == "/" %} class="shell home"{% else %} class="shell"{% endif %}>
    {{ content | safe }}
  </main>

  <footer class="site-foot">
    <div class="shell">
      <p class="pledge">{{ site.pledge }}</p>
      <p class="disclaimer">{{ site.disclaimer }}</p>
      <p class="colophon">&copy; {{ site.buildYear }} {{ site.author.name }}. <a href="/feed.xml">RSS</a>, <a href="{{ site.author.github }}">GitHub</a> and <a href="{{ site.author.linkedin }}">LinkedIn</a>.</p>
    </div>
  </footer>
</body>
</html>
