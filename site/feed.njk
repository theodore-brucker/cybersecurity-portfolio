---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="/feed.xsl"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en-US">
  <title>{{ site.title }} | Cybersecurity Blog</title>
  <subtitle>Weekly writing on building and assessing security programs, compliance, and detection.</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/blog/" rel="alternate" type="text/html"/>
  <updated>{{ collections.posts | newestModified | dateToRfc3339 }}</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.author.name }}</name>
    <uri>{{ site.url }}/</uri>
  </author>
  <rights>{{ site.disclaimer }}</rights>
  {%- for post in collections.posts %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ site.url }}{{ post.url }}" rel="alternate" type="text/html"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <published>{{ post.date | dateToRfc3339 }}</published>
    <updated>{{ post | postModified | dateToRfc3339 }}</updated>
    <author>
      <name>{{ site.author.name }}</name>
      <uri>{{ site.url }}/</uri>
    </author>
    {%- for tag in post.data.tags | reject("equalto", "posts") %}
    <category term="{{ tag }}"/>
    {%- endfor %}
    <summary>{{ post.data.summary }}</summary>
    <content type="html">{{ post.templateContent | htmlToAbsoluteUrls(site.url + post.url) }}</content>
  </entry>
  {%- endfor %}
</feed>
